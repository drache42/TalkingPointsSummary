      "name": "Get Existing Messages"
    },
    {
      "parameters": {
        "jsCode": "// Get new messages from Node 3\nconst newMessages = $('Extract Messages').all();\n\n// Get stored messages from Node 4\nconst storedMessages = $('Get Existing Messages').all();\n\n// Create a Set of stored message IDs for fast lookup\nconst storedIds = new Set(\n  storedMessages.map(item => item.json.message_id)\n);\n\n// Filter to only messages we haven't stored yet\nconst messagesToStore = newMessages.filter(\n  item => !storedIds.has(item.json.message_id)\n);\n\n// If no new messages, return empty array (stops workflow)\nreturn messagesToStore;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
