    {
      "parameters": {
        "jsCode": "// Extract messages from API response\nconst response = $input.first().json;\nconst messages = response.data?.messages || [];\n\n// Transform each message into our table format\nreturn messages.map(msg => ({\n  json: {\n    message_id: msg._id,\n    to_student: msg.contactInfo.studentName,\n    contact_message_id: msg.contactMessageId,\n    message_text: msg.text || '',\n    from_name: msg.from?.user?.signature || msg.fromName || '',\n    created_at: msg.createdAt,\n    sent_at: msg.displayDate,\n    processed_at: new Date().toISOString()\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        176
      ],
      "id": "a356106a-f2e6-4c6b-8b4c-c53f0f05a41a",
      "name": "Extract Messages"
    },
    {
