<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin the feed for the repo so restore does not depend on machine/user NuGet.config state.
       <clear/> drops any inherited sources (including a broken/empty user config). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
