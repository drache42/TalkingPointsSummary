# Docker Compose .env overrides
# docker-compose.yml reads these values before it starts the containers.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEBUG_FEATURES_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
# For Gmail, use an App Password — see docs/gmail-smtp.md
SMTP_PASSWORD=
SMTP_FROM=your-email@example.com
TPS_LOGS_PATH=./runtime-data/logs
ADMIN_DATA_PROTECTION_KEYS_PATH=./runtime-data/admin-data-protection-keys

# Direct worker environment variables
# Use these names when running the worker directly via dotnet run or when
# setting environment variables outside Docker Compose.
ConnectionStrings__TalkingPoints=Host=localhost;Database=talkingpoints;Username=postgres;Password=postgres
Anthropic__ApiKey=your-anthropic-api-key-here
Browserless__BaseUrl=http://localhost:3000
DebugFeatures__Enabled=false
Smtp__Host=localhost
Smtp__Port=1025
Smtp__Username=
# For Gmail, use an App Password — see docs/gmail-smtp.md
Smtp__Password=
Smtp__FromEmail=your-email@example.com
DataProtection__KeysDirectory=
PipelineSchedule__DayOfWeek=1
PipelineSchedule__Hour=8
NewsletterScrapingSecurity__Enabled=true
NewsletterScrapingSecurity__RequireHttps=true
