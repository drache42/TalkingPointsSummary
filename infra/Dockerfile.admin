FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy csproj files and restore
COPY src/TalkingPointsSummary.Core/TalkingPointsSummary.Core.csproj src/TalkingPointsSummary.Core/
COPY src/TalkingPointsSummary.Admin/TalkingPointsSummary.Admin.csproj src/TalkingPointsSummary.Admin/
COPY Directory.Build.props ./
COPY Directory.Packages.props ./
RUN dotnet restore src/TalkingPointsSummary.Admin/TalkingPointsSummary.Admin.csproj

# Copy everything and publish
COPY . .
WORKDIR /src/src/TalkingPointsSummary.Admin
RUN dotnet publish -c Release -o /app/publish

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
RUN apt-get update \
	&& apt-get install -y --no-install-recommends libgssapi-krb5-2 \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .

EXPOSE 8080
ENTRYPOINT ["dotnet", "TalkingPointsSummary.Admin.dll"]