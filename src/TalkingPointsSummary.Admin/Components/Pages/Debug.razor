@page "/debug"
@rendermode InteractiveServer
@inject IWebHostEnvironment Environment
@inject PipelineDebugClient PipelineDebugClient
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Debug - TalkingPoints Admin</PageTitle>

<h1 class="mb-3">Debug</h1>

@if (!Environment.IsDevelopment())
{
    <div class="alert alert-warning" role="alert">
        Debug tools are only available in Development.
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="card-title">Run Pipeline Now</h5>
            <p class="card-text text-muted mb-3">
                Trigger the main worker pipeline immediately using the same execution path as the manual worker command.
            </p>

            @if (!PipelineDebugClient.IsConfigured)
            {
                <div class="alert alert-warning" role="alert">
                    Worker trigger URL is not configured for this environment.
                </div>
            }
            else
            {
                <p class="small text-muted mb-3">Target: @PipelineDebugClient.BaseUrl</p>
            }

            <div class="mb-3">
                <label class="form-label" for="run-parent-scope">Run scope</label>
                <select id="run-parent-scope"
                        class="form-select"
                        @bind="_selectedParentIdValue"
                        disabled="@(_isRunning || _parentOptionsLoading)">
                    <option value="">All active parents</option>
                    @foreach (var parent in _parentOptions)
                    {
                        <option value="@parent.Id.ToString()">@parent.DisplayName</option>
                    }
                </select>
                @if (_parentOptionsLoading)
                {
                    <div class="form-text">Loading active parents...</div>
                }
                else if (_parentOptions.Count == 0)
                {
                    <div class="form-text text-warning">No active parents are available.</div>
                }
                else
                {
                    <div class="form-text">Choose a single active parent or leave it on all active parents.</div>
                }
            </div>

            <button class="btn btn-danger"
                    @onclick="RunNowAsync"
                    disabled="@(_isRunning || !PipelineDebugClient.IsConfigured || _parentOptionsLoading)">
                @(_isRunning ? "Running..." : SelectedParentId.HasValue ? "Run Selected Parent" : "Run All Parents")
            </button>
        </div>
    </div>

    <div class="card border-danger shadow-sm mb-3">
        <div class="card-body">
            <h5 class="card-title text-danger">Clear Pipeline Data</h5>
            <p class="card-text text-muted mb-3">
                Delete all messages, summaries, and news items while keeping parents and children.
            </p>

            <div class="mb-3">
                <label class="form-label" for="delete-parent-scope">Delete scope</label>
                <select id="delete-parent-scope"
                        class="form-select"
                        @bind="_selectedDeleteParentIdValue"
                        @bind:after="OnDeleteScopeChangedAsync"
                        disabled="@(_isClearingData || _deleteParentOptionsLoading)">
                    <option value="">All parents</option>
                    @foreach (var parent in _deleteParentOptions)
                    {
                        <option value="@parent.Id.ToString()">@parent.DisplayName</option>
                    }
                </select>
                @if (_deleteParentOptionsLoading)
                {
                    <div class="form-text">Loading parents...</div>
                }
                else if (_deleteParentOptions.Count == 0)
                {
                    <div class="form-text text-warning">No parents are available.</div>
                }
                else
                {
                    <div class="form-text">Delete data for one parent or leave it on all parents.</div>
                }
            </div>

            @if (_dataCountsLoading)
            {
                <p class="text-muted mb-3">Loading current counts...</p>
            }
            else
            {
                <p class="small text-muted mb-3">Showing counts for @(SelectedDeleteParentId.HasValue ? $"parent {SelectedDeleteParentId.Value}" : "all parents").</p>

                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <div class="border rounded p-3 bg-light-subtle h-100">
                            <div class="small text-muted">Messages</div>
                            <div class="fs-4 fw-semibold">@_messageCount</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded p-3 bg-light-subtle h-100">
                            <div class="small text-muted">Summaries</div>
                            <div class="fs-4 fw-semibold">@_summaryCount</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded p-3 bg-light-subtle h-100">
                            <div class="small text-muted">News Items</div>
                            <div class="fs-4 fw-semibold">@_newsItemCount</div>
                        </div>
                    </div>
                </div>
            }

            <div class="form-check mb-3">
                <input id="confirm-clear-data"
                       class="form-check-input"
                       type="checkbox"
                       @bind="_confirmClearData" />
                <label class="form-check-label" for="confirm-clear-data">
                    I understand this deletes the selected messages, summaries, and news items.
                </label>
            </div>

            <button class="btn btn-outline-danger"
                    @onclick="ClearPipelineDataAsync"
                    disabled="@(_isClearingData || !_confirmClearData)">
                @(_isClearingData ? "Deleting..." : SelectedDeleteParentId.HasValue ? "Delete Selected Parent Data" : "Delete All Parent Data")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_runStatusMessage))
    {
        <div class="alert @RunStatusAlertClass" role="alert">
            @_runStatusMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_clearStatusMessage))
    {
        <div class="alert @ClearStatusAlertClass" role="alert">
            @_clearStatusMessage
        </div>
    }
}

@code {
    private bool _isRunning;
    private bool? _lastRunSucceeded;
    private bool _lastRunWasConflict;
    private bool _lastRunParentNotFound;
    private string? _runStatusMessage;
    private bool _dataCountsLoading = true;
    private bool _parentOptionsLoading = true;
    private bool _deleteParentOptionsLoading = true;
    private bool _isClearingData;
    private bool _confirmClearData;
    private int _messageCount;
    private int _summaryCount;
    private int _newsItemCount;
    private bool? _lastClearSucceeded;
    private string? _clearStatusMessage;
    private string? _selectedParentIdValue;
    private string? _selectedDeleteParentIdValue;
    private List<DebugParentOption> _parentOptions = [];
    private List<DebugParentOption> _deleteParentOptions = [];

    private int? SelectedParentId => int.TryParse(_selectedParentIdValue, out var parentId)
        ? parentId
        : null;

    private int? SelectedDeleteParentId => int.TryParse(_selectedDeleteParentIdValue, out var parentId)
        ? parentId
        : null;

    private string RunStatusAlertClass => _isRunning
        ? "alert-info"
        : _lastRunSucceeded == true
            ? "alert-success"
            : _lastRunWasConflict
                ? "alert-warning"
                : _lastRunParentNotFound
                    ? "alert-warning"
                : "alert-danger";

    private string ClearStatusAlertClass => _isClearingData
        ? "alert-info"
        : _lastClearSucceeded == true
            ? "alert-success"
            : "alert-danger";

    protected override async Task OnInitializedAsync()
    {
        await LoadParentOptionsAsync();
        await LoadDeleteParentOptionsAsync();
        await LoadDataCountsAsync();
    }

    private async Task RunNowAsync()
    {
        _isRunning = true;
        _lastRunSucceeded = null;
        _lastRunWasConflict = false;
        _lastRunParentNotFound = false;
        _runStatusMessage = SelectedParentId.HasValue
            ? $"Running pipeline for parent {SelectedParentId.Value}..."
            : "Running pipeline for all active parents...";

        try
        {
            var result = await PipelineDebugClient.RunNowAsync(SelectedParentId);
            _lastRunSucceeded = result.Success;
            _lastRunWasConflict = result.AlreadyRunning;
            _lastRunParentNotFound = result.ParentNotFound;
            _runStatusMessage = result.Message;
        }
        catch (Exception ex)
        {
            _lastRunSucceeded = false;
            _lastRunWasConflict = false;
            _lastRunParentNotFound = false;
            _runStatusMessage = $"Pipeline trigger failed: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
        }
    }

    private async Task ClearPipelineDataAsync()
    {
        _isClearingData = true;
        _lastClearSucceeded = null;
        _clearStatusMessage = "Deleting messages, summaries, and news items...";

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            var messageQuery = db.Messages.AsQueryable();
            var summaryQuery = db.Summaries.AsQueryable();
            var newsItemQuery = db.NewsItems.AsQueryable();

            if (SelectedDeleteParentId.HasValue)
            {
                var parentId = SelectedDeleteParentId.Value;
                messageQuery = messageQuery.Where(message => message.ParentId == parentId);
                summaryQuery = summaryQuery.Where(summary => summary.ParentId == parentId);
                newsItemQuery = newsItemQuery.Where(newsItem => newsItem.ParentId == parentId);
            }

            var deletedMessages = await messageQuery.ExecuteDeleteAsync();
            var deletedSummaries = await summaryQuery.ExecuteDeleteAsync();
            var deletedNewsItems = await newsItemQuery.ExecuteDeleteAsync();

            await transaction.CommitAsync();

            _lastClearSucceeded = true;
            _confirmClearData = false;
            _clearStatusMessage = SelectedDeleteParentId.HasValue
                ? $"Deleted {deletedMessages} messages, {deletedSummaries} summaries, and {deletedNewsItems} news items for parent {SelectedDeleteParentId.Value}."
                : $"Deleted {deletedMessages} messages, {deletedSummaries} summaries, and {deletedNewsItems} news items for all parents.";

            await LoadDataCountsAsync();
        }
        catch (Exception ex)
        {
            _lastClearSucceeded = false;
            _clearStatusMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            _isClearingData = false;
        }
    }

    private async Task LoadDataCountsAsync()
    {
        _dataCountsLoading = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var messageQuery = db.Messages.AsQueryable();
            var summaryQuery = db.Summaries.AsQueryable();
            var newsItemQuery = db.NewsItems.AsQueryable();

            if (SelectedDeleteParentId.HasValue)
            {
                var parentId = SelectedDeleteParentId.Value;
                messageQuery = messageQuery.Where(message => message.ParentId == parentId);
                summaryQuery = summaryQuery.Where(summary => summary.ParentId == parentId);
                newsItemQuery = newsItemQuery.Where(newsItem => newsItem.ParentId == parentId);
            }

            _messageCount = await messageQuery.CountAsync();
            _summaryCount = await summaryQuery.CountAsync();
            _newsItemCount = await newsItemQuery.CountAsync();
        }
        finally
        {
            _dataCountsLoading = false;
        }
    }

    private async Task OnDeleteScopeChangedAsync()
    {
        _confirmClearData = false;
        await LoadDataCountsAsync();
    }

    private async Task LoadParentOptionsAsync()
    {
        _parentOptionsLoading = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _parentOptions = await db.Parents
                .Where(parent => parent.IsActive)
                .OrderBy(parent => parent.Name)
                .Select(parent => new DebugParentOption(parent.Id, parent.Name))
                .ToListAsync();
        }
        finally
        {
            _parentOptionsLoading = false;
        }
    }

    private async Task LoadDeleteParentOptionsAsync()
    {
        _deleteParentOptionsLoading = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _deleteParentOptions = await db.Parents
                .OrderBy(parent => parent.Name)
                .Select(parent => new DebugParentOption(
                    parent.Id,
                    parent.IsActive ? $"{parent.Name} (ID: {parent.Id})" : $"{parent.Name} (ID: {parent.Id}, inactive)"))
                .ToListAsync();
        }
        finally
        {
            _deleteParentOptionsLoading = false;
        }
    }

    private sealed record DebugParentOption(int Id, string DisplayName);
}