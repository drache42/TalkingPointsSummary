@page "/parents/{ParentId:int}/children/create"
@page "/parents/{ParentId:int}/children/{Id:int}/edit"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Edit Child" : "Add Child") — TalkingPoints Admin</PageTitle>

<nav aria-label="breadcrumb" class="mb-1">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/parents">Parents</a></li>
        <li class="breadcrumb-item"><a href="/parents/@ParentId">@_parentName</a></li>
        <li class="breadcrumb-item active">@(Id.HasValue ? "Edit Child" : "Add Child")</li>
    </ol>
</nav>

<h1 class="mb-3">@(Id.HasValue ? "Edit Child" : "Add Child")</h1>

@if (_notFound)
{
    <div class="alert alert-danger">Not found.</div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="child-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <InputText @bind-Value="_model.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">School</label>
                    <InputText @bind-Value="_model.School" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Grade</label>
                    <InputSelect @bind-Value="_model.Grade" class="form-select">
                        <option value="0">Kindergarten</option>
                        @for (int g = 1; g <= 12; g++)
                        {
                            <option value="@g">Grade @g</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Emoji</label>
                    <EmojiPicker @bind-Value="_model.Emoji" />
                    <div class="form-text">Used as a heading icon in summaries.</div>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
                <a href="/parents/@ParentId" class="btn btn-secondary ms-2">Cancel</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int ParentId { get; set; }
    [Parameter] public int? Id { get; set; }

    private ChildInputModel _model = new();
    private string _parentName = string.Empty;
    private bool _saving;
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var parent = await db.Parents.FindAsync(ParentId);
        if (parent is null) { _notFound = true; return; }
        _parentName = parent.Name;

        if (Id.HasValue)
        {
            var child = await db.Children.FindAsync(Id.Value);
            if (child is null || child.ParentId != ParentId) { _notFound = true; return; }

            _model = new ChildInputModel
            {
                Name = child.Name,
                School = child.School,
                Grade = CurrentSchoolGrade(child),
                Emoji = child.Emoji,
            };
        }
        // Grade defaults to 0 (Kindergarten) for new children
    }

    private async Task SaveAsync()
    {
        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        if (Id.HasValue)
        {
            var child = await db.Children.FindAsync(Id.Value);
            if (child is null) { _notFound = true; _saving = false; return; }

            child.Name = _model.Name;
            child.School = _model.School;
            child.StartingGrade = _model.Grade;
            child.StartingYear = CurrentSchoolYear();
            child.Emoji = _model.Emoji;
        }
        else
        {
            db.Children.Add(new Child
            {
                ParentId = ParentId,
                Name = _model.Name,
                School = _model.School,
                StartingGrade = _model.Grade,
                StartingYear = CurrentSchoolYear(),
                Emoji = _model.Emoji,
            });
        }

        await db.SaveChangesAsync();
        Nav.NavigateTo($"/parents/{ParentId}");
    }

    private sealed class ChildInputModel
    {
        [Required, MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required, MaxLength(300)]
        public string School { get; set; } = string.Empty;

        [Range(0, 12)]
        public int Grade { get; set; }

        public string Emoji { get; set; } = "📚";
    }

    private static int CurrentSchoolYear()
    {
        var now = DateTime.UtcNow;
        return now.Month >= 9 ? now.Year : now.Year - 1;
    }

    private static int CurrentSchoolGrade(Child child)
    {
        var current = CurrentSchoolYear();
        return child.StartingGrade + Math.Max(0, current - child.StartingYear);
    }
}
