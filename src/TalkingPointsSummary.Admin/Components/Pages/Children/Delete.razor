@page "/parents/{ParentId:int}/children/{Id:int}/delete"
@rendermode InteractiveServer
@inject IParentService ParentService
@inject IChildService ChildService
@inject NavigationManager Nav

<PageTitle>Delete Child — TalkingPoints Admin</PageTitle>

<nav aria-label="breadcrumb" class="mb-1">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/parents">Parents</a></li>
        <li class="breadcrumb-item"><a href="/parents/@ParentId">@_parentName</a></li>
        <li class="breadcrumb-item active">Delete Child</li>
    </ol>
</nav>

<h1 class="mb-3">Delete Child</h1>

@if (_child is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="alert alert-warning">
        <strong>Are you sure?</strong> Delete <strong>@_child.Emoji @_child.Name</strong>?
        This cannot be undone.
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_deleting">
            @(_deleting ? "Deleting…" : "Yes, Delete")
        </button>
        <a href="/parents/@ParentId" class="btn btn-secondary">Cancel</a>
    </div>
}

@code {
    [Parameter] public int ParentId { get; set; }
    [Parameter] public int Id { get; set; }

    private Child? _child;
    private string _parentName = string.Empty;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        _child = await ChildService.GetChildAsync(ParentId, Id);
        if (_child is not null)
        {
            var parent = await ParentService.GetParentAsync(ParentId);
            _parentName = parent?.Name ?? string.Empty;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        _deleting = true;
        try
        {
            await ChildService.DeleteChildAsync(ParentId, Id);
        }
        catch (EntityNotFoundException)
        {
        }
        Nav.NavigateTo($"/parents/{ParentId}");
    }
}
