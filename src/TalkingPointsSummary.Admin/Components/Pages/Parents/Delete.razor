@page "/parents/{Id:int}/delete"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Delete Parent — TalkingPoints Admin</PageTitle>

<nav aria-label="breadcrumb" class="mb-1">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/parents">Parents</a></li>
        @if (_parent is not null)
        {
            <li class="breadcrumb-item"><a href="/parents/@_parent.Id">@_parent.Name</a></li>
        }
        <li class="breadcrumb-item active">Delete</li>
    </ol>
</nav>

<h1 class="mb-3">Delete Parent</h1>

@if (_parent is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="alert alert-warning">
        <strong>Are you sure?</strong> Deleting <strong>@_parent.Name</strong> will permanently remove all their
        children (@_parent.Children.Count), messages, news items, and summaries.
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_deleting">
            @(_deleting ? "Deleting…" : "Yes, Delete")
        </button>
        <a href="/parents/@_parent.Id" class="btn btn-secondary">Cancel</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Parent? _parent;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _parent = await db.Parents
            .Include(p => p.Children)
            .FirstOrDefaultAsync(p => p.Id == Id);
    }

    private async Task ConfirmDeleteAsync()
    {
        _deleting = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var parent = await db.Parents.FindAsync(Id);
        if (parent is not null)
        {
            db.Parents.Remove(parent);
            await db.SaveChangesAsync();
        }
        Nav.NavigateTo("/parents");
    }
}
