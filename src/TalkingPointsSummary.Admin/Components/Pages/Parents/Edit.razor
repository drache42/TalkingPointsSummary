@page "/parents/create"
@page "/parents/{Id:int}/edit"
@rendermode InteractiveServer
@inject IParentService ParentService
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Edit Parent" : "Add Parent") — TalkingPoints Admin</PageTitle>

<nav aria-label="breadcrumb" class="mb-1">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/parents">Parents</a></li>
        @if (Id.HasValue)
        {
            <li class="breadcrumb-item"><a href="/parents/@Id">@_originalName</a></li>
        }
        <li class="breadcrumb-item active">@(Id.HasValue ? "Edit" : "Add Parent")</li>
    </ol>
</nav>

<h1 class="mb-3">@(Id.HasValue ? "Edit Parent" : "Add Parent")</h1>

@if (_notFound)
{
    <div class="alert alert-danger">Parent not found.</div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="parent-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <InputText @bind-Value="_model.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold d-flex align-items-center gap-2">
                        TalkingPoints Token
                        <InfoTooltip Text="Sign in at families.talkingpts.org, open DevTools (F12), switch to Network, refresh, click any authenticated TalkingPoints request, then copy X-Token from Request Headers." />
                    </label>
                    <InputText @bind-Value="_model.TalkingPointsToken" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold d-flex align-items-center gap-2">
                        TalkingPoints Contact ID
                        <InfoTooltip Text="Sign in at families.talkingpts.org, open DevTools (F12), switch to Network, refresh, click any authenticated TalkingPoints request, then copy X-Contactid from Request Headers." />
                    </label>
                    <InputText @bind-Value="_model.TalkingPointsContactId" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Recipients</label>
                    <EmailListEditor @bind-Value="_model.EmailRecipients" />
                </div>
                <div class="mb-4 form-check">
                    <InputCheckbox @bind-Value="_model.IsActive" class="form-check-input" id="isActive" />
                    <label class="form-check-label" for="isActive">Active</label>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
                <a href="/parents" class="btn btn-secondary ms-2">Cancel</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private ParentInputModel _model = new();
    private string _originalName = string.Empty;
    private bool _saving;
    private bool _notFound;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        _errorMessage = null;

        if (!Id.HasValue) return;

        var parent = await ParentService.GetParentAsync(Id.Value);
        if (parent is null) { _notFound = true; return; }

        _originalName = parent.Name;
        _model = new ParentInputModel
        {
            Name = parent.Name,
            TalkingPointsToken = parent.TalkingPointsToken,
            TalkingPointsContactId = parent.TalkingPointsContactId,
            EmailRecipients = parent.EmailRecipients,
            IsActive = parent.IsActive,
        };
    }

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (Id.HasValue)
            {
                await ParentService.UpdateParentAsync(
                    Id.Value,
                    new UpdateParentRequest(
                        _model.Name,
                        _model.TalkingPointsToken,
                        _model.TalkingPointsContactId,
                        _model.EmailRecipients,
                        _model.IsActive));
            }
            else
            {
                await ParentService.CreateParentAsync(
                    new CreateParentRequest(
                        _model.Name,
                        _model.TalkingPointsToken,
                        _model.TalkingPointsContactId,
                        _model.EmailRecipients,
                        _model.IsActive));
            }

            Nav.NavigateTo("/parents");
        }
        catch (ValidationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (EntityNotFoundException)
        {
            _notFound = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class ParentInputModel
    {
        [Required, MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required]
        public string TalkingPointsToken { get; set; } = string.Empty;

        [Required, MaxLength(100)]
        public string TalkingPointsContactId { get; set; } = string.Empty;

        [Required]
        public string EmailRecipients { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
    }
}
